# RefRef Refer Server Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# Database Configuration (REQUIRED)
# PostgreSQL connection string
# For Docker: use the default below
# For local: update with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/refref"

# Server Configuration (OPTIONAL)
# Port for the refer server (default: 3002)
PORT=3002

# Host to bind to (default: 0.0.0.0)
HOST="0.0.0.0"

# Log level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL="info"

# --- Welfie referral fork additions ---

# Path prefix the app is mounted under at the reverse proxy (e.g. "/refer").
# Leave blank to serve /invite/:code at the root.
REFER_BASE_PATH="/refer"

# Public origin that serves the /:code redirects, used to build referral links
# handed out by /join. This is this app's own origin and must NOT include
# REFER_BASE_PATH, because /:code is registered at the root.
# With portless: http://refref-refer.localhost:1355 | Without: http://localhost:3002
REFERRAL_HOST_URL="http://refref-refer.localhost:1355"

# Where the referee is redirected after submitting the form.
WELFIE_SIGNUP_URL="https://welfie.com/signup"

# Consent copy version stored with every lead (bump when the wording changes).
REFERRAL_CONSENT_VERSION="privacy-2026-08"
# Link shown beside the consent checkbox.
PRIVACY_POLICY_URL="https://welfie.com/privacy"

# Single-use hand-off token TTL (minutes).
HANDOFF_TTL_MINUTES=10

# Extra disposable email domains to reject (comma/space separated).
DISPOSABLE_DOMAINS_EXTRA=""

# Optional Cloudflare Turnstile (CAPTCHA). If a secret is set it is enforced.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
