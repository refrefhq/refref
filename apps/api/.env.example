# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/refref"

# Referral Configuration
# With portless: http://refref-refer.localhost:1355 | Without: http://localhost:3002
REFERRAL_HOST_URL="http://refref-refer.localhost:1355"

# --- Welfie referral fork additions ---

# Outbound webhook dispatcher. Set to "true" to run the worker inside the API
# process; leave unset and run `pnpm --filter @refref/api worker` as its own
# process in production.
WEBHOOK_WORKER_ENABLED="false"
# Poll interval for the webhook worker (ms).
WEBHOOK_WORKER_INTERVAL_MS=5000

# Email-reconciliation attribution window for late/cross-device signups (days).
ATTRIBUTION_WINDOW_DAYS=30
